{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assists": {
		"enabled": false
	},

	"formatter": {
		"attributePosition": "auto",
		"bracketSpacing": true,
		"enabled": true,
		"formatWithErrors": true,
		"ignore": [
			".vscode/**",
			"**/node_modules/**",
			"**/out/**",
			"**/include/**",
			"*.code-workspace",
			"tsconfig.json"
		],
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 120,
		"useEditorconfig": false
	},

	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"attributePosition": "auto",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"enabled": false,
			"indentStyle": "tab",
			"indentWidth": 4,
			"jsxQuoteStyle": "double",
			"lineEnding": "lf",
			"lineWidth": 120,
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},

	"linter": {
		"enabled": true,
		"ignore": [".vscode/**", "node_modules/**", "*.code-workspace", "tsconfig.json"],
		"rules": {
			"recommended": true,
			"correctness": {
				"useExhaustiveDependencies": {
					"level": "warn",
					"options": {
						"hooks": [
							{
								"closureIndex": 0,
								"dependenciesIndex": 1,
								"name": "useAsyncEffect"
							},
							{
								"name": "useBinding",
								"stableResult": [0, 1]
							},
							{
								"closureIndex": 1,
								"dependenciesIndex": 2,
								"name": "useEventConnection"
							}
						],
						"reportMissingDependenciesArray": true,
						"reportUnnecessaryDependencies": false
					}
				}
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noConfusingVoidType": "off",
				"noConstEnum": "off",
				"noExplicitAny": "off",
				"noExportsInTest": "off",
				"noShadowRestrictedNames": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noParameterAssign": "off",
				"useImportType": "off"
			}
		}
	},

	"organizeImports": {
		"enabled": true,
		"ignore": ["**/node_modules/**", "**/out/**", "**/include/**"],
		"include": ["**/*.ts", "**/*.js"]
	},

	"overrides": [
		{
			"include": [".vscode/**", "*.code-workspace", "tsconfig.json"],
			"ignore": ["garbage/**"],
			"json": {
				"formatter": {
					"enabled": true,
					"indentStyle": "tab",
					"indentWidth": 4,
					"lineWidth": 120,
					"trailingCommas": "all"
				},
				"linter": { "enabled": true },
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		}
	],

	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true,
		"useIgnoreFile": true
	}
}
